# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Real Online Payment Gateways (optional - configure at least one to enable electronic payments)
STRIPE_SECRET_KEY=""
MOYASAR_SECRET_KEY=""
TAP_SECRET_KEY=""

# Firebase Cloud Messaging Web Push VAPID Key (optional - from Firebase Console > Project Settings > Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=""
